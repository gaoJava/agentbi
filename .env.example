# No insecure default is provided for secrets. Set a sufficiently long random value.
AGENTBI_API_KEY=replace-with-at-least-32-random-characters
AGENTBI_SESSION_SECRET=replace-with-an-independent-32-character-random-secret
AGENTBI_ENABLE_DEMO_LOGIN=false
AGENTBI_DEMO_USER_PASSWORD=
AGENTBI_DEMO_ADMIN_PASSWORD=
SUPERSONIC_BASE_URL=http://localhost:9080
SUPERSET_BASE_URL=http://127.0.0.1:8088
SUPERSET_DASHBOARD_PATH=/superset/dashboard/1/
SUPERSET_USER=admin
SUPERSET_PASSWORD=change-me
SUPERSONIC_TOKEN=
SUPERSONIC_USER=
SUPERSONIC_PASSWORD=
# Long-dialogue compression uses both token and message-count triggers.
AGENTBI_CONVERSATION_TOKEN_THRESHOLD=6000
AGENTBI_CONVERSATION_MESSAGE_THRESHOLD=20
AGENTBI_CONVERSATION_KEEP_RECENT_TURNS=4
AGENTBI_REQUEST_TIMEOUT_SECONDS=20
AGENTBI_MAX_RESULT_ROWS=500
AGENTBI_REQUESTS_PER_MINUTE=30
AGENTBI_IDEMPOTENCY_TTL_SECONDS=300
AGENTBI_ALLOWED_ORIGINS=http://localhost:8088
