# Copy to a local .env file. Never include the populated file in a submission.
AGENTBI_API_KEY=replace-with-32-or-more-random-characters
AGENTBI_SESSION_SECRET=replace-with-32-or-more-random-characters
AGENTBI_DATABASE_URL=sqlite:///./data/agentbi.db
SUPERSONIC_BASE_URL=http://127.0.0.1:9080
SUPERSONIC_USER=replace-me
SUPERSONIC_PASSWORD=replace-me
SUPERSET_BASE_URL=http://127.0.0.1:8088
SUPERSET_USER=replace-me
SUPERSET_PASSWORD=replace-me
AGENTBI_ALLOWED_ORIGINS=http://127.0.0.1:8088,http://127.0.0.1:8090

